   "locked_text": "El destilador Sabatier de Bruno. Faltan ingredientes: hielo, CO₂ y níquel.",
   "use_lines": [
    {
     "who": "hal",
     "text": "Paso 1: electrólisis. El hielo derretido se separa en hidrógeno y oxígeno."
    },
    {
     "who": "hal",
     "text": "Paso 2: reacción de Sabatier. CO₂ + 4 H₂ → CH₄ + 2 H₂O, con el níquel como catalizador."
    },
    {
     "who": "bruno",
     "text": "¡Y el agua que sale vuelve al paso 1! Así no se desperdicia nada."
