 "arrival_lines": [
  {
   "who": "hal",
   "text": "Buenos días, Andrés. Sistemas de HAL en línea. Calidad del aire: mala. Ánimo: ¡bueno!"
  },
  {
   "who": "andres",
   "text": "HAL, hoy es el día. La abuela Lucía nos espera en la Bóveda Semillera."
  },
  {
   "who": "hal",
   "text": "Sigue la flecha dorada. Muévete con WASD y habla con la gente pulsando E."
  },
  {
   "who": "hal",
   "text": "Llovizna ácida de nivel bajo y apagón en medio barrio. Por suerte, los letreros de neón nunca se apagan."
  }
 ]
