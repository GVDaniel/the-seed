   "prompt": "Instalar el motor de metano",
   "locked_text": "El banco de trabajo de Bruno. Primero hace falta un motor que instalar.",
   "use_lines": [
    {
     "who": "bruno",
     "text": "¡Allá vamos! Quito el CX-50, ajusto los anclajes y conecto las tuberías de metano y oxígeno."
    },
    {
     "who": "bruno",
     "text": "Listo. El Corazón Rojo está montado… pero el tanque de metano está vacío."
    },
    {
     "who": "hal",
     "text": "Para fabricar metano necesitamos tres ingredientes: hidrógeno (del hielo), carbono (del CO₂) y un catalizador de níquel."
    },
    {
     "who": "hal",
     "text": "Pregunta en la colonia: Yusuf, Nia y Ada pueden ayudarnos. Son misiones secundarias, haz las que quieras primero."
    }
   ],
   "done_lines": [
    {
     "who": "bruno",
     "text": "El Corazón Rojo está bien sujeto. Ni una tuerca floja."
    }
   ]
