; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Seed"
config/description="Demo educativa de RPG espacial: astronomía y bases de programación. Nave ASTRA."
config/version="0.8.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
ApiClient="*res://scripts/autoload/api_client.gd"
ScienceNotebook="*res://scripts/autoload/science_notebook.gd"
MissionLog="*res://scripts/autoload/mission_log.gd"
StoryDirector="*res://scripts/autoload/story_director.gd"
Router="*res://scripts/autoload/scene_router.gd"
Sfx="*res://scripts/autoload/sfx_player.gd"
Music="*res://scripts/autoload/music_player.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Economy="*res://scripts/autoload/economy.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

